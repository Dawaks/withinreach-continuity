# WithinReach Continuity — Environment Variables
# Copy this file to .env and adjust as needed.

# Database (SQLite for local development)
DATABASE_URL=sqlite:///./continuity.db

# AI / Amazon Bedrock (disabled by default for local development)
AI_ENABLED=false

# Bedrock model ID — example default. Configurable and swappable.
# The application must not assume this exact model is always available.
# If the configured model is unavailable, the app falls back to rule-based/structured mode.
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_REGION=us-east-1

# Demo data (seeds Grace Community Church on startup)
SEED_DEMO_DATA=true
